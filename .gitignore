# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Local dev config/secrets (Luna Shopper). The tracked .env.development /
# .env.production only hold NODE_ENV; these git ignored files carry local runtime
# config and secrets. Only the .example files are committed. See
# apps/luna-shopper-backend/.env.luna-shopper-backend.example and each apps/luna-shopper-backend/<svc>/.env.example.
/.env
/.env.local
apps/luna-shopper-backend/.env.luna-shopper-backend
apps/luna-shopper-backend/*/.env
# Opt-in test database URLs (plan 0013); only the .env.test.example files are committed.
apps/luna-shopper-backend/*/.env.test
# pg_dump snapshots written by luna-shopper-backend:db:snapshot (plan 0013, section 3.2).
apps/luna-shopper-backend/.snapshots/
# Per worktree compose slot file written by luna-slot.sh / luna-slot.ps1, and the
# logs and pid files of the services its --up started.
k8s/e2e/luna-shopper-backend/.env.slot
k8s/e2e/luna-shopper-backend/.run/
# The front end half of the same idea, written by tools/dev/ng-slot.sh / .ps1: the
# slot descriptor, the per app .env files Nx loads into each project's tasks
# (MFE_REMOTE_URLS for the shell, the backend URLs for velista), and the logs and
# pid files of whatever --up started. All of it is per worktree by design.
tools/dev/.env.ng-slot
tools/dev/.run/
apps/shell/.env
apps/velista/.env
apps/luna-shopper-admin/.env
# Jest JSON summaries and per service logs from the stack targets (plan 0015);
# CI reads them to prove the infra-backed suites actually executed, then uploads
# them as failure artifacts. Nothing here is worth committing.
/test-output
# Local dev JWT keypair lives here (out of any .env); the dir is kept via .gitkeep.
apps/luna-shopper-backend/secrets/*
!apps/luna-shopper-backend/secrets/.gitkeep
jwt.key
jwt.pub

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.angular

!**/.gitkeep
!**/.gitignore

.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing

# The live ddclient config carries a Cloudflare API token that can rewrite every
# record in the zone. Only the .example next to it is committed.
docker/ddns/config/
# npm cache, redirected into the workspace when installing inside the pinned build
# container (see .github/actions/workspace).
.npm
