# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# Local dev config/secrets (Luna Shopper). The tracked .env.development /
# .env.production only hold NODE_ENV; these git ignored files carry local runtime
# config and secrets. Only the .example files are committed. See
# apps/luna-shopper/.env.luna-shopper.example and each apps/luna-shopper/<svc>/.env.example.
/.env
/.env.local
apps/luna-shopper/.env.luna-shopper
apps/luna-shopper/*/.env
# Local dev JWT keypair lives here (out of any .env); the dir is kept via .gitkeep.
apps/luna-shopper/secrets/*
!apps/luna-shopper/secrets/.gitkeep
jwt.key
jwt.pub

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.angular

!**/.gitkeep
!**/.gitignore

.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing