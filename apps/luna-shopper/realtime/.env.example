# Realtime local dev env. Copy to apps/luna-shopper/realtime/.env
# Shared vars (NATS_URL, LOG_LEVEL, CORS_ORIGINS) come from
# apps/luna-shopper/.env.luna-shopper.

# Auth public key, read from a file so no PEM lives in .env.
AUTH_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper/secrets/jwt.pub

# PORT defaults to 3001; uncomment to override.
# PORT=3001
