# Catalog local dev env. Copy to apps/luna-shopper/catalog/.env
# Shared vars (NATS_URL, LOG_LEVEL, CORS_ORIGINS) come from
# apps/luna-shopper/.env.luna-shopper. The luna-slot.sh / luna-slot.ps1 helper
# writes this file for you when you place the worktree on a slot.

CATALOG_DB_URL=postgres://luna_catalog:luna_catalog@localhost:5434/luna_catalog

# Auth public key, read from a file so no PEM lives in .env.
AUTH_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper/secrets/jwt.pub

# Comma-separated user ids allowed to WRITE the catalog (the app owner / platform
# admin). Reads are open to any authenticated user; writes require membership of
# this allowlist. Empty means no one can write (safe default for local dev).
PLATFORM_ADMIN_USER_IDS=

# PORT is the HTTP health port; defaults to 3004; uncomment to override.
# PORT=3004
