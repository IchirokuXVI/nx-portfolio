# Gateway local dev env. Copy to apps/luna-shopper/gateway/.env
# Shared vars (NATS_URL, LOG_LEVEL, CORS_ORIGINS) come from
# apps/luna-shopper/.env.luna-shopper.

# Auth public key, read from a file so no PEM lives in .env (see
# apps/luna-shopper/.env.luna-shopper.example to generate the keypair).
AUTH_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper/secrets/jwt.pub

# PORT defaults to 3000; uncomment to override.
# PORT=3000
