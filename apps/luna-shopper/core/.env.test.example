# Core TEST database (plan 0013, section 3.1). Copy to
# apps/luna-shopper/core/.env.test, then run any db target with LUNA_ENV=test.
# Loaded first, so this URL wins over apps/luna-shopper/core/.env (a pure
# connection-string swap). Points at the test-profile database in the compose
# stack (docker compose --profile test ... up).
CORE_DB_URL=postgres://luna_core:luna_core@localhost:5443/luna_core_test
