{
  "name": "luna-shopper-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/luna-shopper/core/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/luna-shopper-core"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/luna-shopper/core"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        },
        "production": {
          "args": ["--node-env=production"]
        }
      }
    },
    "build:docker": {
      "executor": "@portfolio/docker:build",
      "options": {
        "imageName": "nx-portfolio/luna-shopper-core",
        "forwardEnv": ["BUILDER_TAG"]
      },
      "configurations": {
        "development": {
          "versionTags": ["dev"],
          "buildArgs": {
            "NODE_ENV": "development",
            "BUILDER_TAG": "dev"
          }
        },
        "production": {
          "pushToRegistry": true,
          "versionTags": ["latest"],
          "buildArgs": {
            "NODE_ENV": "production"
          }
        }
      },
      "defaultConfiguration": "development"
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-core/package.json",
        "{workspaceRoot}/dist/apps/luna-shopper-core/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-core/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "luna-shopper-core:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "luna-shopper-core:build:development"
        },
        "production": {
          "buildTarget": "luna-shopper-core:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/luna-shopper/core/jest.config.cts",
        "passWithNoTests": true
      }
    },
    "test-integration": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/luna-shopper/core/jest.integration.config.cts",
        "runInBand": true,
        "passWithNoTests": true
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper/core/src/app/db/cli.js migration:run -d apps/luna-shopper/core/src/app/db/data-source.ts"
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper/core/src/app/db/cli.js migration:revert -d apps/luna-shopper/core/src/app/db/data-source.ts"
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper/core/src/app/db/cli.js migration:generate apps/luna-shopper/core/src/app/db/migrations/Migration -d apps/luna-shopper/core/src/app/db/data-source.ts"
      }
    }
  }
}
