{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    // `module: commonjs` conflicts with the `moduleResolution: bundler` inherited
    // from tsconfig.base.json (TS5095), which fails the Cypress webpack
    // preprocessor before a single spec runs. Pin the matching resolution here,
    // as shell-e2e already does.
    "moduleResolution": "node10",
    "types": ["cypress", "node"],
    "sourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "cypress.config.ts",
    "**/*.cy.ts",
    "**/*.cy.js",
    "**/*.d.ts"
  ]
}
