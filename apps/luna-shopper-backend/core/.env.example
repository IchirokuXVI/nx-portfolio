# Core local dev env. Copy to apps/luna-shopper-backend/core/.env
# Shared vars (NATS_URL, LOG_LEVEL, CORS_ORIGINS) come from
# apps/luna-shopper-backend/.env.luna-shopper-backend.

CORE_DB_URL=postgres://luna_core:luna_core@localhost:5433/luna_core

# Auth public key, read from a file so no PEM lives in .env.
AUTH_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper-backend/secrets/jwt.pub

# --- Zone reaper (plan 0011) ------------------------------------------------
# Deletes zones marked for deletion (an owner was deleted and no admin claimed
# them) after the grace period, cascading their lists/lines/comments.
ZONE_REAPER_ENABLED=true
ZONE_DELETION_GRACE=7d
ZONE_REAPER_INTERVAL=1h
ZONE_REAPER_BATCH=200

# PORT is the HTTP health port; defaults to 3003; uncomment to override.
# PORT=3003
