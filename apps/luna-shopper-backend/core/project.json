{
  "name": "luna-shopper-backend-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/luna-shopper-backend/core/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/luna-shopper-backend-core"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/luna-shopper-backend/core"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        },
        "production": {
          "args": ["--node-env=production"]
        }
      }
    },
    "build:docker": {
      "executor": "@portfolio/docker:build",
      "dependsOn": ["prune"],
      "options": {
        "imageName": "nx-portfolio/luna-shopper-backend-core",
        "forwardEnv": ["BUILDER_TAG"],
        "context": "dist"
      },
      "configurations": {
        "development": {
          "versionTags": ["dev"],
          "buildArgs": {
            "BUILDER_TAG": "dev"
          }
        },
        "production": {
          "pushToRegistry": true,
          "versionTags": ["latest"]
        }
      },
      "defaultConfiguration": "development"
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-backend-core/package.json",
        "{workspaceRoot}/dist/apps/luna-shopper-backend-core/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-backend-core/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "manifest-check": {
      "// ": "Every bundle in the image can resolve every package it requires (k8s plan 0009). This package.json is hand written and `generatePackageJson` covers the main entry alone, so a package reachable only from migrate.ts, seed-reference.ts or admin-cli.ts reaches the image only if somebody typed it here. Three staging releases have died on a miss, the last one through a pre-upgrade hook that rolled the whole release back. Depends on prune, because the pruned lockfile is what the image installs from.",
      "dependsOn": ["prune"],
      "//cache": "Uncached on purpose. The thing this reads is the dist output of `prune` and the checker script itself, and neither is an input Nx hashes for this project: the script lives outside every project directory, so editing it would replay a cached pass from before the edit. The check itself takes about a second, so there is nothing to save and a stale green to lose.",
      "cache": false,
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper-backend/tools/ci/assert-runtime-manifest.mjs dist/apps/luna-shopper-backend-core"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "luna-shopper-backend-core:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "luna-shopper-backend-core:build:development"
        },
        "production": {
          "buildTarget": "luna-shopper-backend-core:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/luna-shopper-backend/core/jest.config.cts",
        "passWithNoTests": true
      }
    },
    "test-integration": {
      "executor": "@nx/jest:jest",
      "// ": "Uncached on purpose (plan 0015, section 3.3): the result depends on LUNA_INTEGRATION, LUNA_REQUIRE_STACK and the live database, none of which Nx hashes, so a replayed cache entry could report a pass from a run that skipped everything. The JSON summary is what CI reads to prove the suite actually executed specs.",
      "cache": false,
      "options": {
        "jestConfig": "apps/luna-shopper-backend/core/jest.integration.config.cts",
        "runInBand": true,
        "passWithNoTests": true,
        "json": true,
        "outputFile": "test-output/luna-shopper-backend/integration/luna-shopper-backend-core.json"
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper-backend/core/src/app/db/cli.js migration:run -d apps/luna-shopper-backend/core/src/app/db/data-source.ts"
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper-backend/core/src/app/db/cli.js migration:revert -d apps/luna-shopper-backend/core/src/app/db/data-source.ts"
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper-backend/core/src/app/db/cli.js migration:generate apps/luna-shopper-backend/core/src/app/db/migrations/Migration -d apps/luna-shopper-backend/core/src/app/db/data-source.ts"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper-backend/core/src/app/db/seed/cli.js"
      }
    }
  }
}
