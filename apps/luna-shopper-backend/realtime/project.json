{
  "name": "luna-shopper-backend-realtime",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/luna-shopper-backend/realtime/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/luna-shopper-backend-realtime"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/luna-shopper-backend/realtime"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        },
        "production": {
          "args": ["--node-env=production"]
        }
      }
    },
    "build:docker": {
      "executor": "@portfolio/docker:build",
      "dependsOn": ["prune"],
      "options": {
        "imageName": "nx-portfolio/luna-shopper-backend-realtime",
        "forwardEnv": ["BUILDER_TAG"],
        "context": "dist"
      },
      "configurations": {
        "development": {
          "versionTags": ["dev"],
          "buildArgs": {
            "BUILDER_TAG": "dev"
          }
        },
        "production": {
          "pushToRegistry": true,
          "versionTags": ["latest"]
        }
      },
      "defaultConfiguration": "development"
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-backend-realtime/package.json",
        "{workspaceRoot}/dist/apps/luna-shopper-backend-realtime/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-backend-realtime/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "luna-shopper-backend-realtime:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "luna-shopper-backend-realtime:build:development"
        },
        "production": {
          "buildTarget": "luna-shopper-backend-realtime:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/luna-shopper-backend/realtime/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
