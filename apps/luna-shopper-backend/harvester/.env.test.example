# Harvester TEST database (plan 0013, section 3.1). Copy to
# apps/luna-shopper-backend/harvester/.env.test, then run any db target with
# LUNA_ENV=test. Loaded first, so this URL wins over
# apps/luna-shopper-backend/harvester/.env (a pure connection-string swap).
# Points at the test-profile database in the compose stack
# (docker compose --profile test ... up).
#
# On a slot other than 0, do not copy this file: luna-slot.sh writes the .env.test
# for you with that slot's port. The number below is slot 0's.
HARVESTER_DB_URL=postgres://luna_harvester:luna_harvester@localhost:5445/luna_harvester_test
