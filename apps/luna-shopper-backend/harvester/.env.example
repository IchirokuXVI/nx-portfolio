# Harvester local dev env (plan 0038). Copy to apps/luna-shopper-backend/harvester/.env
# Shared vars (NATS_URL, LOG_LEVEL) come from
# apps/luna-shopper-backend/.env.luna-shopper-backend. The luna-slot.sh / luna-slot.ps1
# helper writes this file for you when you place the worktree on a slot.

HARVESTER_DB_URL=postgres://luna_harvester:luna_harvester@localhost:5435/luna_harvester

# Auth public key, read from a file so no PEM lives in .env.
AUTH_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper-backend/secrets/jwt.pub

# The operator public key (plan 0072). EVERY subject this service exposes is
# gated on a valid admin token, not just the writes, and this is what verifies
# one. Required: the harvester has no second way in, so without this key nothing
# can reach any of its subjects.
ADMIN_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper-backend/secrets/admin-jwt.pub

# The uuid catalog knows this service by (backlog 0001, section 4.1; plan 0072,
# section 4). Put the same uuid in catalog's SERVICE_ACTOR_IDS, so every write the
# harvester makes is accepted as a SERVICE and attributed to the harvester.
#
# It is deliberately not an admin credential. The harvester is a machine, it
# holds no operator token, and a run started by the owner still writes as the
# harvester: attributing 4,000 rows to whoever pressed the button would hide
# which changes a machine made.
HARVESTER_ACTOR_ID=

# PORT is the HTTP health port; defaults to 3005; uncomment to override.
# PORT=3005

# --- The switch --------------------------------------------------------------
# It defaults to false, and that is the point: a deploy that turns fetching on is
# a decision someone makes, never something that happens because a pod started.
#
# HARVEST_ENABLED gates every run mode. With it false the service boots, answers
# its health probes and its read subjects, and refuses to spawn.
HARVEST_ENABLED=false
#
# There is no per chain variable here, and there never will be (plan 0083). A
# chain is switched on and off by its own `supermarket_sources` row, off by
# default, written from the back office, so a second chain is a row rather than a
# second variable to thread through this file and the chart.

# --- Politeness (section 6.3 and 8) -----------------------------------------
# An HONEST User-Agent naming the app and a contact address, and specifically NOT
# the Chrome impersonation the public reference implementations use.
HARVEST_USER_AGENT=LunaShopper/0.1 (+https://velista.app; personal price comparison; contact@velista.app)

# The two knobs do TWO DIFFERENT JOBS and are separate on purpose:
#   HARVEST_DEFAULT_WORKERS bounds how many requests are in flight (sockets, memory)
#   HARVEST_DEFAULT_MAX_RPS bounds our impact on the source (politeness)
# A single per worker delay would be a bug at any concurrency above one: four
# workers each pausing 250 ms is sixteen requests per second, not four. There is
# one token bucket per run that every worker blocks on, which is what makes the
# number below the number the source actually sees.
#
# 4 req/s is the only number in section 6.3 with no evidence behind it: workers
# and concurrency were measured, this was chosen, and it decides whether a run
# takes 9 minutes or 73. Watch for 429s and treat any as a signal to HALVE this
# rather than to retry harder.
HARVEST_DEFAULT_WORKERS=4
HARVEST_DEFAULT_MAX_RPS=4

# How many prices go to catalog in one upsertBatch call.
HARVEST_BATCH_SIZE=200

# A RUNNING run whose heartbeat is older than this (seconds) is reaped as STALE
# and its lock released. This is the only recovery path for a force killed
# harvester, and none other is designed: a lost run costs one refresh cycle.
HARVEST_STALE_AFTER=900

# A run fails outright once this fraction of its planned work has failed. Below
# it, per item failures are counted and logged and the run finishes.
HARVEST_FAILURE_RATIO=0.25

# The postal code discovery queue (plan 0063). A code somebody put on their
# profile that catalog holds no shops in becomes a STORE_DISCOVERY run, one at a
# time. Draining is gated by HARVEST_ENABLED above; the queue fills either way.
#
# HARVEST_DISCOVERY_RADIUS is NOT the profile expansion radius, which is core
# configuration: that one decides which postal codes a person shops in, this one
# how far around a code centre to look for shops, and it is larger because a
# shop at the edge of a code is still that code shop.
HARVEST_DISCOVERY_RADIUS=5000

# Thirty days, because a supermarket opening is a rare event and a closing
# rarer. A thousand users in one postcode cost one run a month between them.
HARVEST_DISCOVERY_COOLDOWN_DAYS=30

# Attempts before a code is left FAILED with its reason, and how often the
# worker looks for a due one.
HARVEST_DISCOVERY_MAX_ATTEMPTS=3
HARVEST_DISCOVERY_POLL_SECONDS=60

# --- Source endpoints --------------------------------------------------------
# All optional; each library has the public default built in. OVERPASS_URL exists
# so a self hosted instance can be pointed at without a code change if usage ever
# grows (section 8.2), and MERCADONA_BASE_URL so a test can point at a local stub.
# MERCADONA_BASE_URL=
# OVERPASS_URL=
# NOMINATIM_URL=
