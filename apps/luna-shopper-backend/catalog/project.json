{
  "name": "luna-shopper-backend-catalog",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/luna-shopper-backend/catalog/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/luna-shopper-backend-catalog"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/luna-shopper-backend/catalog"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        },
        "production": {
          "args": ["--node-env=production"]
        }
      }
    },
    "build:docker": {
      "executor": "@portfolio/docker:build",
      "dependsOn": ["prune"],
      "options": {
        "imageName": "nx-portfolio/luna-shopper-backend-catalog",
        "forwardEnv": ["BUILDER_TAG"],
        "context": "dist"
      },
      "configurations": {
        "development": {
          "versionTags": ["dev"],
          "buildArgs": {
            "BUILDER_TAG": "dev"
          }
        },
        "production": {
          "pushToRegistry": true,
          "versionTags": ["latest"]
        }
      },
      "defaultConfiguration": "development"
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-backend-catalog/package.json",
        "{workspaceRoot}/dist/apps/luna-shopper-backend-catalog/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-backend-catalog/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "luna-shopper-backend-catalog:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "luna-shopper-backend-catalog:build:development"
        },
        "production": {
          "buildTarget": "luna-shopper-backend-catalog:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/luna-shopper-backend/catalog/jest.config.cts",
        "passWithNoTests": true
      }
    },
    "test-integration": {
      "executor": "@nx/jest:jest",
      "// ": "Uncached on purpose (plan 0015, section 3.3): the result depends on LUNA_INTEGRATION, LUNA_REQUIRE_STACK and the live database, none of which Nx hashes, so a replayed cache entry could report a pass from a run that skipped everything. The JSON summary is what CI reads to prove the suite actually executed specs.",
      "cache": false,
      "options": {
        "jestConfig": "apps/luna-shopper-backend/catalog/jest.integration.config.cts",
        "runInBand": true,
        "passWithNoTests": true,
        "json": true,
        "outputFile": "test-output/luna-shopper-backend/integration/luna-shopper-backend-catalog.json"
      }
    },
    "migration:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper-backend/catalog/src/app/db/cli.js migration:run -d apps/luna-shopper-backend/catalog/src/app/db/data-source.ts"
      }
    },
    "migration:revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper-backend/catalog/src/app/db/cli.js migration:revert -d apps/luna-shopper-backend/catalog/src/app/db/data-source.ts"
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper-backend/catalog/src/app/db/cli.js migration:generate apps/luna-shopper-backend/catalog/src/app/db/migrations/Migration -d apps/luna-shopper-backend/catalog/src/app/db/data-source.ts"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node apps/luna-shopper-backend/catalog/src/app/db/seed/cli.js"
      }
    }
  }
}
