# Catalog local dev env. Copy to apps/luna-shopper-backend/catalog/.env
# Shared vars (NATS_URL, LOG_LEVEL, CORS_ORIGINS) come from
# apps/luna-shopper-backend/.env.luna-shopper-backend. The luna-slot.sh / luna-slot.ps1 helper
# writes this file for you when you place the worktree on a slot.

CATALOG_DB_URL=postgres://luna_catalog:luna_catalog@localhost:5434/luna_catalog

# Auth public key, read from a file so no PEM lives in .env.
AUTH_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper-backend/secrets/jwt.pub

# The operator public key (plan 0072), a SECOND key beside the auth one and read
# the same way. Catalog verifies the admin token the gateway forwards against it,
# for itself, rather than trusting the gateway to have checked. Required: without
# it catalog cannot accept any write a person makes.
ADMIN_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper-backend/secrets/admin-jwt.pub

# Comma-separated uuids belonging to SERVICES allowed to write the catalog
# without a token (plan 0072, section 4). The harvester's HARVESTER_ACTOR_ID is
# the only member. This is not an admin list and does not make its holders
# admins: a machine is not a person, and creating an admin never touches this.
# Empty means no service may write, which is the right default for a slot with no
# harvester on it.
SERVICE_ACTOR_IDS=

# PORT is the HTTP health port; defaults to 3004; uncomment to override.
# PORT=3004

# --- Telemetry (plan 0016) ---------------------------------------------------
# These live in this per service file, not the shared .env.luna-shopper-backend,
# and that placement matters: the OpenTelemetry SDK starts before Nest does
# (section 4.1) and can only read `process.env`. Nx loads a project's own `.env`
# into its tasks, so a variable here reaches the SDK; the shared file's custom
# name is known only to @nestjs/config, which runs far too late.
#
# Names this service on every span and metric. It warns at boot if it disagrees
# with the service it is running in.
OTEL_SERVICE_NAME=luna-shopper-backend-catalog
#
# The rest are optional. Left unset, the service runs exactly as it did before
# tracing existed: no exporter is constructed and no network call is attempted.
# To watch traces locally, bring up the observability profile and switch this on:
#
#   docker compose --profile observability \
#     -f k8s/e2e/luna-shopper-backend/compose.yml up -d
#
# Jaeger then lives at http://localhost:16686, Prometheus at :9090, Grafana at
# :3010. luna-slot.sh / luna-slot.ps1 write all of this for you, on slot ports.
#
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Sampling ratio, 0..1. Full locally; lower in production if the volume costs.
# OTEL_TRACES_SAMPLER_ARG=1.0
# DEPLOYMENT_ENVIRONMENT=development
# GET /metrics on this service's HTTP health port. On unless switched off.
# METRICS_ENABLED=true
