# Catalog TEST database (plan 0013, section 3.1). Copy to
# apps/luna-shopper-backend/catalog/.env.test, then run any db target with LUNA_ENV=test.
# Loaded first, so this URL wins over apps/luna-shopper-backend/catalog/.env (a pure
# connection-string swap). Points at the test-profile database in the compose
# stack (docker compose --profile test ... up).
CATALOG_DB_URL=postgres://luna_catalog:luna_catalog@localhost:5444/luna_catalog_test
