{
  "name": "luna-shopper-backend-gateway",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/luna-shopper-backend/gateway/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/luna-shopper-backend-gateway"],
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/luna-shopper-backend/gateway"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        },
        "production": {
          "args": ["--node-env=production"]
        }
      }
    },
    "build:docker": {
      "executor": "@portfolio/docker:build",
      "dependsOn": ["prune"],
      "options": {
        "imageName": "nx-portfolio/luna-shopper-backend-gateway",
        "forwardEnv": ["BUILDER_TAG"],
        "context": "dist"
      },
      "configurations": {
        "development": {
          "versionTags": ["dev"],
          "buildArgs": {
            "BUILDER_TAG": "dev"
          }
        },
        "production": {
          "pushToRegistry": true,
          "versionTags": ["latest"]
        }
      },
      "defaultConfiguration": "development"
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-backend-gateway/package.json",
        "{workspaceRoot}/dist/apps/luna-shopper-backend-gateway/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/apps/luna-shopper-backend-gateway/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "luna-shopper-backend-gateway:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "luna-shopper-backend-gateway:build:development"
        },
        "production": {
          "buildTarget": "luna-shopper-backend-gateway:build:production"
        }
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "{workspaceRoot}",
        "env": {
          "LUNA_WRITE_OPENAPI": "1"
        },
        "command": "npx nx test luna-shopper-backend-gateway --skip-nx-cache --testFile=apps/luna-shopper-backend/gateway/src/app/docs/openapi-document.spec.ts"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/luna-shopper-backend/gateway/jest.config.cts",
        "passWithNoTests": true
      }
    }
  }
}
