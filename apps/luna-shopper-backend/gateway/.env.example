# Gateway local dev env. Copy to apps/luna-shopper-backend/gateway/.env
# Shared vars (NATS_URL, LOG_LEVEL, CORS_ORIGINS) come from
# apps/luna-shopper-backend/.env.luna-shopper-backend.

# Auth public key, read from a file so no PEM lives in .env (see
# apps/luna-shopper-backend/.env.luna-shopper-backend.example to generate the keypair).
AUTH_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper-backend/secrets/jwt.pub

# --- The operator identity (plan 0071) ---------------------------------------
# The second trust root, verifying admin tokens and nothing else. Required, so
# the gateway will not boot without it; luna-slot.sh generates the pair.
ADMIN_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper-backend/secrets/admin-jwt.pub
# What GET /v1/admin/auth/me reports back, and therefore the accent colour the
# back office renders. It comes from the API rather than the bundle because the
# failure being guarded against is believing you are in staging when you are in
# production, and a build time constant is exactly what is wrong there.
ENVIRONMENT_NAME=development
# Skip the password on the login route and ask auth for a token for the admin
# named below. Auth refuses to boot with its own copy of this true against a non
# local database, and provision-release.sh --check refuses a deploy whose render
# so much as mentions the name. The two copies have to agree.
ADMIN_DEV_AUTOLOGIN=false
ADMIN_DEV_AUTOLOGIN_USERNAME=dev-admin

# PORT defaults to 3000; uncomment to override.
# PORT=3000

# --- Google sign in (plan 0023) ----------------------------------------------
# The passport dance runs at the gateway, so the OAuth variables live here as
# well as in auth's env. Leave them unset and the routes stay registered but
# inert, which is a supported state: nothing about boot depends on them.
#
# GOOGLE_CALLBACK_URL must match a URI pre-registered with Google exactly, and
# the request Host header is untrusted, so it cannot be derived from the request.
# GOOGLE_CLIENT_ID=your-dev-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-dev-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback
#
# Where the callback sends the browser back to, and the only source the redirect
# is built from: nothing the client supplied reaches it, which is what keeps it
# from being an open redirect. Required once GOOGLE_CLIENT_ID is set.
#
# `{locale}` is substituted with the locale the flow started in. With no
# placeholder the locale is appended as the first path segment instead; the
# placeholder exists because this frontend mounts the app *after* the locale
# segment (`/{locale}/velista`), which a plain prefix cannot express.
# APP_BASE_URL=http://localhost:4200/{locale}/velista

# --- Telemetry (plan 0016) ---------------------------------------------------
# These live in this per service file, not the shared .env.luna-shopper-backend,
# and that placement matters: the OpenTelemetry SDK starts before Nest does
# (section 4.1) and can only read `process.env`. Nx loads a project's own `.env`
# into its tasks, so a variable here reaches the SDK; the shared file's custom
# name is known only to @nestjs/config, which runs far too late.
#
# Names this service on every span and metric. It warns at boot if it disagrees
# with the service it is running in.
OTEL_SERVICE_NAME=luna-shopper-backend-gateway
#
# The rest are optional. Left unset, the service runs exactly as it did before
# tracing existed: no exporter is constructed and no network call is attempted.
# To watch traces locally, bring up the observability profile and switch this on:
#
#   docker compose --profile observability \
#     -f k8s/e2e/luna-shopper-backend/compose.yml up -d
#
# Jaeger then lives at http://localhost:16686, Prometheus at :9090, Grafana at
# :3010. luna-slot.sh / luna-slot.ps1 write all of this for you, on slot ports.
#
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Sampling ratio, 0..1. Full locally; lower in production if the volume costs.
# OTEL_TRACES_SAMPLER_ARG=1.0
# DEPLOYMENT_ENVIRONMENT=development
# GET /metrics on this service's HTTP port. On unless switched off.
# METRICS_ENABLED=true
