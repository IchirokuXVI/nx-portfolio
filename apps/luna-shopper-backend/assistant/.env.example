# Assistant local dev env (plan 0039). Copy to apps/luna-shopper-backend/assistant/.env
# Shared vars (NATS_URL, LOG_LEVEL) come from
# apps/luna-shopper-backend/.env.luna-shopper-backend. The luna-slot.sh / luna-slot.ps1
# helper writes this file for you when you place the worktree on a slot.
#
# There is no *_DB_URL here and there is not meant to be one. This service owns no
# database and connects to nobody else's: rule A1 says it reaches application data
# only through the API, carrying the caller's own token, and the absence of a
# connection string is the cheapest place for that to be visible.

# Where the assistant calls the app's own API on the caller's behalf. In the
# cluster this is the gateway's internal service name; locally it is your slot's
# gateway. Never a public hostname: going out and back in pays for TLS and the
# ingress for a call that never leaves the cluster.
GATEWAY_INTERNAL_URL=http://localhost:3000

# --- The model provider ------------------------------------------------------
# EMPTY IS A SUPPORTED DEPLOYMENT, not a misconfiguration. With no key the service
# boots, its health probes pass, and every turn answers 501 not_configured (plan
# 0026, applied in section 11). That is also why the key is in
# OPTIONAL_EMPTY_KEYS in provision-release.sh, so `--check` keeps passing on a
# cluster where the assistant is simply not configured.
#
# The suite never needs one: rule A4 forbids any test in this repository from
# reaching a model provider, so everything above the ModelProvider interface runs
# against a fake with no network.
GEMINI_API_KEY=

# The model, as a value rather than a literal, so changing it is an env edit and a
# restart. gemini-3.1-flash-lite is the first thing to try if quality disappoints,
# and the version numbers do not order those two the way they look.
ASSISTANT_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# PORT is the HTTP health port; defaults to 3006; uncomment to override.
# (3005 belongs to the harvester, which landed first.)
# PORT=3006

# --- Caps on the client supplied transcript ----------------------------------
# The service stores nothing between turns (rule A2), so the whole conversation
# arrives on every request. It is UNTRUSTED INPUT: these caps are applied on
# arrival rather than trusted from the client, and a transcript entry is never
# treated as an instruction from the operator whatever it claims about itself.
ASSISTANT_MAX_TURNS=20
ASSISTANT_MAX_CHARS=8000
# How many tool calls one turn may make before the loop stops and answers.
ASSISTANT_MAX_TOOL_CALLS=6

# --- Living inside a free tier (section 9) -----------------------------------
# Google's limits are per Google Cloud project, not per user: roughly ten to
# fifteen requests a minute shared across everybody. With two replicas and a
# handful of concurrent users this WILL return 429 in ordinary use. That is
# accepted rather than engineered around; the requirement is that it be legible,
# which is rule A5: a rate limited turn answers with a number of seconds in the
# problem body, and the panel counts it down.
#
# Both limits below are per instance and in memory. Neither survives a restart and
# neither is shared across replicas. That is a known weakness, written here rather
# than discovered later, and fixing it properly needs storage this plan declines.
ASSISTANT_TURNS_PER_MINUTE=8
# A small concurrency limit in front of the provider call, so a burst queues
# briefly instead of becoming a burst of 429s. Waiting two seconds is invisible,
# being told to come back is not.
ASSISTANT_CONCURRENCY=2
# The floor for retryAfterSeconds when neither the provider's own RetryInfo nor
# the local window can supply one, so the field is never absent.
ASSISTANT_RETRY_AFTER_FALLBACK=30
# ASSISTANT_PROVIDER_TIMEOUT_MS=30000
