# Auth TEST database (plan 0013, section 3.1). Copy to
# apps/luna-shopper-backend/auth/.env.test, then run any db target with LUNA_ENV=test,
# e.g. `LUNA_ENV=test nx run luna-shopper-backend:seed`.
#
# The db tooling loads this file FIRST, and dotenv keeps the first value it sees,
# so this URL wins over apps/luna-shopper-backend/auth/.env — switching between real and
# test data is a pure connection-string swap, no code branching. Only the
# database URL is overridden; every other auth var still comes from .env.
#
# Points at the test-profile database in the compose stack:
#   docker compose --profile test -f k8s/e2e/luna-shopper-backend/compose.yml up -d
AUTH_DB_URL=postgres://luna_auth:luna_auth@localhost:5442/luna_auth_test
