# Auth local dev env. Copy to apps/luna-shopper-backend/auth/.env
# Shared vars (NATS_URL, LOG_LEVEL, CORS_ORIGINS) come from
# apps/luna-shopper-backend/.env.luna-shopper-backend.

AUTH_DB_URL=postgres://luna_auth:luna_auth@localhost:5432/luna_auth

# JWT keypair, read from files so no PEM lives in .env (generate the pair per
# apps/luna-shopper-backend/.env.luna-shopper-backend.example). Auth is the only service with the
# private half.
AUTH_JWT_PRIVATE_KEY_FILE=./apps/luna-shopper-backend/secrets/jwt.key
AUTH_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper-backend/secrets/jwt.pub
AUTH_JWT_KID=dev-1
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- The operator identity (plan 0071) ---------------------------------------
# A SECOND keypair, not the one above with a different audience. Five services
# hold AUTH_JWT_PUBLIC_KEY, so a single key would leave every one of them finding
# an admin token structurally valid and rejecting it only if it remembered to
# check the audience. Two keys make that mistake unrepresentable. Auth holds the
# private half and nothing else does. luna-slot.sh generates the pair.
ADMIN_JWT_PRIVATE_KEY_FILE=./apps/luna-shopper-backend/secrets/admin-jwt.key
ADMIN_JWT_PUBLIC_KEY_FILE=./apps/luna-shopper-backend/secrets/admin-jwt.pub
ADMIN_JWT_KID=dev-admin-1
# The admin session holds no refresh token: the token renews itself while it is
# still valid, and once it is dead it is dead. Raise it locally if you like.
ADMIN_ACCESS_TOKEN_TTL=15m
# Consecutive failures for one username, over this window, before it is refused
# outright. Separate from the gateway's per IP throttle: throttling limits a
# source, this protects an account.
ADMIN_LOGIN_LOCKOUT_THRESHOLD=5
ADMIN_LOGIN_LOCKOUT_WINDOW=15m
# Sign in with no password. A DEVELOPMENT switch, and auth refuses to boot with
# it true and AUTH_DB_URL pointing anywhere but a local database, because a
# service that will not start is a failed deploy and one that logs a warning is a
# compromise nobody read. It issues a token for a named EXISTING admin, so create
# one first: `npx nx run luna-shopper-backend-auth:admin:create dev-admin`.
ADMIN_DEV_AUTOLOGIN=false
ADMIN_DEV_AUTOLOGIN_USERNAME=dev-admin

# --- Google OAuth -----------------------------------------------------------
# Create a dev OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-dev-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-dev-client-secret
# Must EXACTLY match an Authorized redirect URI registered with Google — it
# cannot be derived from the request host (which is untrusted for redirects).
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- SMTP — points at the Mailpit catcher in the compose stack --------------
# (k8s/e2e/luna-shopper-backend/compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Luna Shopper <no-reply@luna.localhost>
# Base URL of the FRONTEND that renders the verification page (a different origin
# than this API, and there is no "current domain" inside an email), so it is
# explicit config, not derived from the request.
#
# It is velista's own origin (4205), not the shell's (4200), because that is the
# shape production sends: velista.app serves the app standalone with an empty
# mount. The path is `auth/verify`, which is the route the app declares; the
# `/verify-email` this file used to suggest matched nothing.
#
# There is no locale segment and there must not be one. `localeGuard` inserts a
# locale in front of a path that has none and carries the query string across, so
# the link resolves to `/{locale}/auth/verify?token=...` in whatever language the
# reader's browser or last visit settles on. A locale written in here would hand
# every recipient the same one.
MAIL_VERIFY_BASE_URL=http://localhost:4205/auth/verify
# A placeholder for a page that does not exist yet: nothing in `feature-auth`
# routes a reset token. The variable is required, so it is set and unusable.
MAIL_RESET_BASE_URL=http://localhost:4205/reset-password

# --- Orphan temporary-user reaper (plan 0011) -------------------------------
# Deletes temporary users that hold no zone membership after a grace period.
# Core is the authority on membership and is asked before each deletion.
ORPHAN_REAPER_ENABLED=true
ORPHAN_USER_GRACE=30d
ORPHAN_REAPER_INTERVAL=1h
ORPHAN_REAPER_BATCH=200

# PORT is the HTTP health port; defaults to 3002; uncomment to override.
# PORT=3002

# --- Telemetry (plan 0016) ---------------------------------------------------
# These live in this per service file, not the shared .env.luna-shopper-backend,
# and that placement matters: the OpenTelemetry SDK starts before Nest does
# (section 4.1) and can only read `process.env`. Nx loads a project's own `.env`
# into its tasks, so a variable here reaches the SDK; the shared file's custom
# name is known only to @nestjs/config, which runs far too late.
#
# Names this service on every span and metric. It warns at boot if it disagrees
# with the service it is running in.
OTEL_SERVICE_NAME=luna-shopper-backend-auth
#
# The rest are optional. Left unset, the service runs exactly as it did before
# tracing existed: no exporter is constructed and no network call is attempted.
# To watch traces locally, bring up the observability profile and switch this on:
#
#   docker compose --profile observability \
#     -f k8s/e2e/luna-shopper-backend/compose.yml up -d
#
# Jaeger then lives at http://localhost:16686, Prometheus at :9090, Grafana at
# :3010. luna-slot.sh / luna-slot.ps1 write all of this for you, on slot ports.
#
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Sampling ratio, 0..1. Full locally; lower in production if the volume costs.
# OTEL_TRACES_SAMPLER_ARG=1.0
# DEPLOYMENT_ENVIRONMENT=development
# GET /metrics on this service's HTTP health port. On unless switched off.
# METRICS_ENABLED=true
