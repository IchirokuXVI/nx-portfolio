{
  "name": "luna-shopper/carrefour",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/luna-shopper/carrefour/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/luna-shopper/carrefour/jest.config.cts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "capture-fixtures": {
      "//": "Refreshes the checked in fixtures from the live site (plan 0090, section 10). Never run by CI: it launches Chromium and makes real requests, and the fixtures are what keeps every other test off both.",
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx libs/luna-shopper/carrefour/tools/capture-fixtures.ts"
      }
    }
  }
}
