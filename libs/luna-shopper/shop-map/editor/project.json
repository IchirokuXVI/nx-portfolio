{
  "name": "luna-shopper/shop-map/editor",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/luna-shopper/shop-map/editor/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "//": "Type checks the library and bundles the demo page into dist/libs/luna-shopper/shop-map/editor/demo, which opens from disk (editor plan 0001).",
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/luna-shopper/shop-map/editor"],
      "options": {
        "command": "webpack-cli build --node-env=production",
        "cwd": "libs/luna-shopper/shop-map/editor"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/luna-shopper/shop-map/editor/jest.config.cts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
