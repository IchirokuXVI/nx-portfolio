{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    // `jest` on top of `node` because src/jest.ts (the integration gate, plan
    // 0015 section 3.1) reaches for Jest's globals. This is a test only library,
    // so the test runner's types belong in its own type surface.
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
