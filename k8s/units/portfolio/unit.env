# The portfolio deploy unit (k8s plan 0014). Its apps are the projects tagged
# deploy:portfolio, and `node tools/deploy/units.mjs check` keeps the two equal.
UNIT=portfolio
NAMESPACE=portfolio
RELEASE_NAME=portfolio
CHART=k8s/helm/portfolio
TAG_PREFIX=portfolio-v
# Gate directories under k8s/e2e, in the order they run.
GATES="portfolio-frontend"
# The portfolio apps own no Secret.
SECRETS=""
RELEASE_TASKS=false
# The public hosts, one list per environment. Read by host maintenance and the endpoint
# checks; asserted against the rendered Gateway by `provision-release.sh --check` (plan 0015).
HOSTS_STAGING="staging.ichirokuxvi.com mfe.staging.ichirokuxvi.com"
HOSTS_PRODUCTION="ichirokuxvi.com mfe.ichirokuxvi.com"
# The variables the bundle build of this unit needs, per environment. stage-unit.yml
# and release-unit.yml pass them to `nx build`, beside the version they set.
BUILD_ENV_STAGING="MFE_BASE_URL=https://mfe.staging.ichirokuxvi.com"
BUILD_ENV_PRODUCTION="MFE_BASE_URL=https://mfe.ichirokuxvi.com"
