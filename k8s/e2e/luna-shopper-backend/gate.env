# The velista unit's API gate (k8s plan 0016 D3): luna-shopper-backend-e2e
# against the six service images of compose.apps.yml. gate.sh wraps
# `stack.sh e2e-images`.
#
# No browser host: the suite speaks to the published gateway port.
HOSTS=""
# The suite and the services it drives. Its implicitDependencies name only the
# gateway and realtime, so a change to another service alone would not mark the
# suite affected. Naming the services here keeps the gate running for it.
TRIGGERS="luna-shopper-backend-e2e luna-shopper-backend-gateway luna-shopper-backend-realtime luna-shopper-backend-auth luna-shopper-backend-core luna-shopper-backend-catalog luna-shopper-backend-assistant luna-shopper-backend-harvester"
BROWSERS="playwright"
IMAGES="luna-shopper-backend-gateway luna-shopper-backend-realtime luna-shopper-backend-auth luna-shopper-backend-core luna-shopper-backend-catalog luna-shopper-backend-assistant"
