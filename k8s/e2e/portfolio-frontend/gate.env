# The portfolio unit's gate (k8s plan 0016 D3). gate.sh starts compose.yml,
# checks the remotes and the /velista path, and runs the affected suites.
#
# The /etc/hosts names the pipeline points at 127.0.0.1 before gate.sh runs.
HOSTS="staging.ichirokuxvi.com mfe.staging.ichirokuxvi.com"
# The e2e projects whose being affected runs this gate.
TRIGGERS="shell-e2e odontogram-e2e damoclesSword-e2e landingV2-e2e"
# playwright, cypress, both or none: the browsers the pipeline installs.
BROWSERS="both"
# The images compose.yml runs, pulled at the run's tag. velista is the other
# unit's image, kept for the portfolio's /velista route (plan 0015 D6).
IMAGES="shell odontogram damoclessword landingv2 velista"
