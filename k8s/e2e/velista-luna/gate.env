# The velista unit's browser gate (k8s plan 0016 D3): velista's own image on its
# origin and under /velista of a portfolio shaped host, plus the Luna stack when
# velista-luna-e2e is affected. The portfolio stack is not started.
HOSTS="staging.velista.app staging.ichirokuxvi.com api.staging.velista.app rt.staging.velista.app"
TRIGGERS="velista-e2e velista-luna-e2e"
BROWSERS="playwright"
IMAGES="velista luna-shopper-backend-gateway luna-shopper-backend-realtime luna-shopper-backend-auth luna-shopper-backend-core luna-shopper-backend-catalog luna-shopper-backend-assistant"
