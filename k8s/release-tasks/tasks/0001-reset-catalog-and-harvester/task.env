# Empty the catalog and harvester databases, then clear core's references to
# what they held (k8s/catalog-reset/README.md). Core is dumped too, because the
# cleanup in post.sh writes to it.
#
# This task ran in both clusters on 2026-09-25, and production release 0.11.0
# ran it there. Each window is the day it ran, so both are closed (k8s plan
# 0011, section 5). A ledger that is lost or edited can no longer start it.
RUN_UNTIL_STAGING="2026-09-25"
RUN_UNTIL_PRODUCTION="2026-09-25"
PRODUCTION_RELEASE="0.11.0"
DATABASES="catalog harvester core"
#
# The most products the catalog may hold for this task to start. check.sh
# counts the rows of `items` and refuses above this number.
MAX_ITEMS_STAGING="0"
MAX_ITEMS_PRODUCTION="0"
