# Remove every product from catalog, then clear the links to them in harvester
# and core (k8s/catalog-reset/remove-catalog-products.sh). Everything else in
# the three databases stays.
#
# This task ran in both clusters on 2026-10-02, and production release 0.12.0
# ran it there. Each window is the day it ran, so both are closed (k8s plan
# 0011, section 5). A ledger that is lost or edited can no longer start it.
RUN_UNTIL_STAGING="2026-10-02"
RUN_UNTIL_PRODUCTION="2026-10-02"
PRODUCTION_RELEASE="0.12.0"
DATABASES="catalog harvester core"
#
# The most products the catalog may hold for this task to start. check.sh
# counts the rows of `items` and refuses above this number.
MAX_ITEMS_STAGING="0"
MAX_ITEMS_PRODUCTION="0"
